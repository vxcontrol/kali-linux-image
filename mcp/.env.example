# Copy to .env and fill in at least MCP_GATEWAY_TOKEN.
#   cp .env.example .env
#   # openssl rand -hex 32

# Image run by docker-compose.yml (Compose does not build it). Defaults to the
# published image on Docker Hub. To run a locally built image instead, build it
# from the repository ROOT (one directory up) and point this at that tag:
#   (cd .. && docker buildx bake mcp --set="mcp.tags=local/kali-linux:mcp" --load)
#   KALI_MCP_IMAGE=local/kali-linux:mcp
KALI_MCP_IMAGE=vxcontrol/kali-linux:mcp

# Address clients use to reach the gateway, e.g. https://$MCP_GATEWAY_IP:$MCP_GATEWAY_PORT/mcp
# This is deliberately not passed into the container: agentgateway 1.5.0 has
# no bind-address field and binds 0.0.0.0/[::]. With host networking, enforce
# this destination IP in the host firewall; see README.md.
MCP_GATEWAY_IP=127.0.0.1

# Port of the aggregated MCP endpoint (/mcp and /sse). Default matches the image.
MCP_GATEWAY_PORT=8081

# Public MCP TLS. Enabled by default. If both files are absent, the container
# generates a private CA and a server certificate in the persistent SSL volume.
MCP_GATEWAY_USE_TLS=true
MCP_GATEWAY_TLS_CERT=/opt/kali-mcp/ssl/server.crt
MCP_GATEWAY_TLS_KEY=/opt/kali-mcp/ssl/server.key
MCP_GATEWAY_TLS_CA=/opt/kali-mcp/ssl/service_ca.crt
# Additional OpenSSL SAN entries. MCP_GATEWAY_IP is appended automatically.
# MCP_GATEWAY_TLS_SAN=DNS:kali-mcp.example.com,IP:10.100.1.3
# Named volume by default; set an absolute host directory to supply cert/key.
# KALI_MCP_SSL_DIR=/srv/kali-mcp/ssl

# Required. Bearer token, at least 16 characters.
# Generate with: openssl rand -hex 32
MCP_GATEWAY_TOKEN=

# Optional. Comma-separated server names to leave out.
# Known names: nmap, masscan, whatweb, pdtools, nuclei, sqlmap, ffuf,
# waybackurls, playwright, metasploit, searchsploit, hashcat, binwalk, tshark, burp
# Disabling metasploit also skips starting msfrpcd.
# KALI_MCP_DISABLE=

# In-container Burp Suite. BURP_ACCEPT_EULA=true is the operator accepting
# PortSwigger's EULA; without it Burp is not started. The MCP BApp then
# joins the same gateway as burp_* tools (stdio proxy to 127.0.0.1:9876).
BURP_ACCEPT_EULA=true
BURP_HEAP=2g
# Xvfb supplies the Swing runtime Burp Desktop requires without opening a window.
BURP_HEADLESS=xvfb

# Leave BURP_MCP_URL empty to use the in-container instance. Set it only to
# point at a Burp that is already running elsewhere (skips local start).
# BURP_MCP_URL=http://192.0.2.10:9876
# BURP_MCP_TRANSPORT=sse

# Burp (~700MB) is baked into the image by default (WITH_BURP=true). To skip the
# layer, build with `docker buildx bake mcp --set "mcp.args.WITH_BURP=false"`;
# the first start then downloads the same pinned artifacts.

# Chromium /dev/shm size inside the container.
# KALI_MCP_SHM_SIZE=2gb
